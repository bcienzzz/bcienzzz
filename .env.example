# Copia questo file in ".env.local" e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API). ".env.local" non viene mai salvato su Git.

# Indirizzo del progetto, es. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave pubblica "anon": può stare nel browser, permette solo di leggere.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave segreta "service_role": SOLO per lo script di importazione. Mai nel browser, mai su Git.
SUPABASE_SERVICE_ROLE_KEY=
